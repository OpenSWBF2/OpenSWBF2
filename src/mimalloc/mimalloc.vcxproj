      <PreprocessorDefinitions>MI_DEBUG=0;MI_SECURE=0;MI_TRACK_ASAN=1;MI_NO_GETENV=1;MI_USE_RTLGENRANDOM;%(PreprocessorDefinitions)</PreprocessorDefinitions>
