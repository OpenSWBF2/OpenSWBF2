    <D3dxCache>$(LOCALAPPDATA)\OpenSWBF2\vendor\</D3dxCache>
    <D3dxNupkgName>microsoft.dxsdk.d3dx.$(D3dxVersion).nupkg</D3dxNupkgName>
    <D3dxNupkg>$(D3dxCache)$(D3dxNupkgName)</D3dxNupkg>
    <D3dxDir>$(D3dxCache)$(D3dxVersion)\</D3dxDir>
    <D3dxArch Condition="'$(Platform)'=='Win32'">x86</D3dxArch>
    <D3dxArch Condition="'$(Platform)'=='x64'">x64</D3dxArch>
    <D3dxDll>$(D3dxDir)build\native\release\bin\$(D3dxArch)\D3DX9_43.dll</D3dxDll>
    <D3dxDllSha256 Condition="'$(Platform)'=='Win32'">$(D3dxWin32Sha256)</D3dxDllSha256>
    <D3dxDllSha256 Condition="'$(Platform)'=='x64'">$(D3dxX64Sha256)</D3dxDllSha256>
    <D3dxDownloadName>$(D3dxNupkgName).$([System.Guid]::NewGuid().ToString('N')).download</D3dxDownloadName>
  </PropertyGroup>
  <Target Name="StageTestsD3dx" AfterTargets="Build">
    <DownloadFile Condition="!Exists('$(D3dxNupkg)')" SourceUrl="$(D3dxNupkgUrl)" DestinationFolder="$(D3dxCache)" DestinationFileName="$(D3dxDownloadName)" />
    <VerifyFileHash Condition="!Exists('$(D3dxNupkg)')" File="$(D3dxCache)$(D3dxDownloadName)" Algorithm="SHA256" Hash="$(D3dxNupkgSha256)" />
    <Move Condition="!Exists('$(D3dxNupkg)')" SourceFiles="$(D3dxCache)$(D3dxDownloadName)" DestinationFiles="$(D3dxNupkg)" />
    <Delete Files="$(D3dxCache)$(D3dxDownloadName)" />
    <VerifyFileHash File="$(D3dxNupkg)" Algorithm="SHA256" Hash="$(D3dxNupkgSha256)" />
    <GetFileHash Condition="Exists('$(D3dxDll)')" Files="$(D3dxDll)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="D3dxDllHash" />
    </GetFileHash>
    <Unzip Condition="'$(D3dxDllHash)' != '$(D3dxDllSha256)'" SourceFiles="$(D3dxNupkg)" DestinationFolder="$(D3dxDir)" Include="build\native\release\bin\**\D3DX9_43.dll" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <VerifyFileHash File="$(D3dxDll)" Algorithm="SHA256" Hash="$(D3dxDllSha256)" />
    <Copy SourceFiles="$(D3dxDll)" DestinationFiles="$(OutDir)d3dx9_43.dll" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageTestsFFmpeg" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\bin\$(Platform)\$(Configuration)\openswbf2-ffmpeg.dll;$(MSBuildThisFileDirectory)..\src\FFmpegFL\COPYING.LGPLv2.1;$(MSBuildThisFileDirectory)..\src\FFmpegFL\NOTICE.txt" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
