<idea-plugin>
    <id>org.openswbf2.riderlink</id>
    <name>OpenSWBF2 Link</name>
    <vendor>OpenSWBF2</vendor>
    <description>Shows the log of a running OpenSWBF2 Debug or Test game and drives it with Play, Pause, Resume, Step Frame and Stop.</description>
    <depends>com.intellij.modules.rider</depends>
    <depends>com.jetbrains.rider-cpp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="org.openswbf2.riderlink.LinkStartup"/>
        <projectConfigurable groupId="tools" id="OpenSWBF2LogSettings" bundle="messages.OpenSWBF2LinkBundle"
                             instance="org.openswbf2.riderlink.OpenSWBF2LogSettingsConfigurable"
                             key="configurable.OpenSWBF2Log.settings.title"/>
        <colorSettings implementation="org.openswbf2.riderlink.OpenSWBF2LogColorSettingsPage"
                       bundle="messages.OpenSWBF2LinkBundle" key="color.settings.openswbf2.console.name" id="openswbf2_log"/>

        <consoleActionsPostProcessor
                implementation="org.openswbf2.riderlink.OpenSWBF2LogConsoleActionsPostProcessor"/>
        <iconMapper mappingFile="OpenSWBF2IconMappings.json"/>

        <projectSettings service="org.openswbf2.riderlink.LinkSettings"/>
        <projectSettings service="org.openswbf2.riderlink.OpenSWBF2LogPanelSettings"/>
    </extensions>

    <actions resource-bundle="messages.OpenSWBF2LinkBundle">
        <group id="OpenSWBF2InteractionToolbar">
            <action id="OpenSWBF2Link.StartGame" class="org.openswbf2.riderlink.PlayInGameAction"/>
            <action id="OpenSWBF2Link.ResumeGame"
                    class="org.openswbf2.riderlink.ResumeInGameAction"/>
            <action id="OpenSWBF2Link.PauseGame" class="org.openswbf2.riderlink.PauseInGameAction"/>
            <action id="OpenSWBF2Link.SingleStepGame"
                    class="org.openswbf2.riderlink.SingleStepInGameAction"/>
            <action id="OpenSWBF2Link.StopGame" class="org.openswbf2.riderlink.StopInGameAction"/>
            <group id="OpenSWBF2Link.GamePlaySettings" popup="true"
                   class="org.openswbf2.riderlink.PlaySettings">
                <action id="OpenSWBF2Link.ProtocolStatus" class="org.openswbf2.riderlink.ProtocolStatus" />
                <separator/>
                <action id="OpenSWBF2Link.AttachToConnectedGame"
                        class="org.openswbf2.riderlink.AttachToConnectedGame"
                        icon="AllIcons.Debugger.AttachToProcess"/>
                <action id="OpenSWBF2Link.OpenOpenSWBF2LinkSettings" class="org.openswbf2.riderlink.OpenOpenSWBF2LinkSettings"
                        icon="AllIcons.General.Settings"/>
                <separator/>
                <action id="OpenSWBF2Link.HidePlayActions"
                        class="org.openswbf2.riderlink.HidePlayButtonsAction" />
                <separator/>
                <group id="OpenSWBF2Link.Games" popup="true"
                       class="org.openswbf2.riderlink.GamePicker"/>
            </group>
            <separator/>
            <add-to-group group-id="NavBarToolBar" relative-to-action="ToolbarRunGroup" anchor="before"/>
            <add-to-group group-id="MainToolBar" relative-to-action="ToolbarRunGroup" anchor="before"/>
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
            <add-to-group group-id="RightToolbarSideGroup" anchor="first"/>
            <add-to-group group-id="RightToolbarSideGroupXamarin" anchor="first"/>
        </group>
    </actions>
</idea-plugin>
